#!/bin/sh
# Blocks commits that would add secrets or private data.
# Uses .gitleaks.local.toml (private, git-ignored) if present, else .gitleaks.toml.
# Activated by `npm install` (package.json "prepare" sets core.hooksPath).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not installed, skipping (brew install gitleaks)"
  exit 0
fi
cd "$(git rev-parse --show-toplevel)" || exit 1
CONFIG=.gitleaks.toml
[ -f .gitleaks.local.toml ] && CONFIG=.gitleaks.local.toml
if ! gitleaks protect --staged --config "$CONFIG" --redact -v; then
  echo ""
  echo "pre-commit: gitleaks found possible secrets or private data in staged changes ($CONFIG). Commit blocked."
  echo "Remove them (or adjust the config if it's a false positive) and try again."
  exit 1
fi
